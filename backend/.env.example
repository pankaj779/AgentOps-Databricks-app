# Copy this file to `backend/.env` and fill in DATABRICKS_TOKEN there.
# Never commit real tokens. `backend/.env` is gitignored.
#
# DATABRICKS_HOST — workspace hostname only (no https://)
DATABRICKS_HOST=dbc-f0bdca80-26a1.cloud.databricks.com
#
# DATABRICKS_HTTP_PATH — SQL warehouse HTTP path from SQL Warehouses UI
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/53cee49fd4be3597
#
# DATABRICKS_TOKEN — set only in `.env`, not in this example file
DATABRICKS_TOKEN=
#
# Optional workspace id (for display / future REST calls)
DATABRICKS_WORKSPACE_ID=7474657421948938
#
# Optional: auto-discover all *payload tables in a UC schema (recommended for AI Gateway multi-route logging)
# AGENTOPS_INFERENCE_SCHEMA=agentops.agent_logs
# AGENTOPS_INFERENCE_TABLE_SUFFIX=_payload
#
# Overrides (optional): explicit comma-separated tables, or single table
# AGENTOPS_INFERENCE_TABLES=agentops.agent_logs.a_payload,agentops.agent_logs.b_payload
# AGENTOPS_INFERENCE_TABLE=catalog.schema.table
#
# If AI Gateway creates one Delta table per route in the same schema, prefer AGENTOPS_INFERENCE_SCHEMA only.
#
# Optional: exact event-time column if auto-detect fails (see /api/v1/inference/diagnostics)
# AGENTOPS_INFERENCE_TIME_COLUMN=request_time
#
# Optional: emergency UI-only demo metrics — keep false for real data
# AGENTOPS_USE_DEMO_METRICS=false
#
# Same logical task across models: set this column name on your logger, identical value = one comparison group
# AGENTOPS_COMPARISON_GROUP_COLUMN=comparison_group_id
#
# Optional: HTTP replay + benchmark targets (OpenAI-style chat JSON). See POST /api/v1/replay/run
# Prefer a file on Windows (avoids .env quoting issues):
# AGENTOPS_REPLAY_TARGETS_FILE=replay_targets.example.json
#
# Or one line in .env (no line breaks):
# AGENTOPS_REPLAY_TARGETS_JSON=[{"id":"claude","label":"Claude route","url":"https://example/v1/chat/completions","headers":{}}]
#
# Optional: POST /api/v1/benchmark/prompt — same user message to every replay target (enable only for trusted demos)
# AGENTOPS_BENCHMARK_ENABLED=false
# AGENTOPS_BENCHMARK_MAX_TARGETS=6
